# ── Hermes (OpenAI-compatible) API ────────────────────────────────
# Base URL of the OpenAI-compatible endpoint, WITHOUT a trailing slash.
# The route calls: {HERMES_BASE_URL}/chat/completions
HERMES_BASE_URL=https://your-hermes-endpoint.example.com/v1

# API key (server-side only, never exposed to the browser)
HERMES_API_KEY=

# Model id understood by your Hermes endpoint
HERMES_MODEL=hermes-3-405b

# ── Optional ──────────────────────────────────────────────────────
# Override the system prompt (shown to the model)
# SYSTEM_PROMPT=

# Shown as a small badge in the UI header (optional)
NEXT_PUBLIC_MODEL_NAME=

# ── File upload API (Hermes upload service) ───────────────────────
# Base URL of the upload service (no trailing slash)
UPLOAD_API_URL=http://100.116.108.51:8643
# Where uploaded files land on the agent's machine (used to build the
# path passed to the agent unless the upload response provides one)
UPLOAD_BASE_PATH=/home/husaynirfan/.hermes/uploads
